@page "/"
@inject DosenService DosenService
@inject MahasiswaService MahasiswaService

<PageTitle>Beranda</PageTitle>

<PageHeader Title="Beranda"
            Subtitle="Sistem Informasi Akademik Sederhana. Ringkasan data dosen dan mahasiswa." />

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="summary-icon summary-icon-dosen" aria-hidden="true"></span>
                    <div>
                        <h2 class="h5 mb-1">Dosen</h2>
                        <p class="text-muted small mb-0">Tenaga pengajar terdaftar</p>
                    </div>
                </div>

                @if (_isLoadingDosen)
                {
                    <div class="d-flex align-items-center gap-2 text-muted mb-3">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Memuat data dosen...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_dosenError))
                {
                    <LoadErrorAlert Message="@_dosenError" OnRetry="MuatDosenAsync" />
                }
                else
                {
                    <p class="display-6 mb-1">@_jumlahDosen</p>
                    <p class="text-muted mb-0">Total dosen</p>
                }

                <div class="d-flex flex-wrap gap-2 mt-auto pt-3">
                    <NavLink href="dosen/tambah" Match="NavLinkMatch.All" class="btn btn-primary">
                        Tambah Dosen
                    </NavLink>
                    <NavLink href="dosen" Match="NavLinkMatch.All" class="btn btn-outline-primary">
                        Lihat Daftar
                    </NavLink>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="summary-icon summary-icon-mahasiswa" aria-hidden="true"></span>
                    <div>
                        <h2 class="h5 mb-1">Mahasiswa</h2>
                        <p class="text-muted small mb-0">Mahasiswa terdaftar</p>
                    </div>
                </div>

                @if (_isLoadingMahasiswa)
                {
                    <div class="d-flex align-items-center gap-2 text-muted mb-3">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Memuat data mahasiswa...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_mahasiswaError))
                {
                    <LoadErrorAlert Message="@_mahasiswaError" OnRetry="MuatMahasiswaAsync" />
                }
                else
                {
                    <p class="display-6 mb-1">@_jumlahMahasiswa</p>
                    <p class="text-muted mb-0">Total mahasiswa</p>
                }

                <div class="d-flex flex-wrap gap-2 mt-auto pt-3">
                    <NavLink href="mahasiswa/tambah" Match="NavLinkMatch.All" class="btn btn-primary">
                        Tambah Mahasiswa
                    </NavLink>
                    <NavLink href="mahasiswa" Match="NavLinkMatch.All" class="btn btn-outline-primary">
                        Lihat Daftar
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isLoadingDosen = true;
    private bool _isLoadingMahasiswa = true;
    private int _jumlahDosen;
    private int _jumlahMahasiswa;
    private string? _dosenError;
    private string? _mahasiswaError;

    protected override async Task OnInitializedAsync()
    {
        _isLoadingDosen = true;
        _isLoadingMahasiswa = true;
        _dosenError = null;
        _mahasiswaError = null;

        try
        {
            // Kedua request independen, jadi jalankan paralel.
            var tugasDosen = MuatDosenInternalAsync();
            var tugasMahasiswa = MuatMahasiswaInternalAsync();

            await Task.WhenAll(tugasDosen, tugasMahasiswa);
        }
        catch (Exception)
        {
            // Jaring pengaman jika service melempar exception tak terduga.
            const string pesanUmum = "Terjadi kesalahan saat memuat data.";

            if (string.IsNullOrWhiteSpace(_dosenError) && _jumlahDosen == 0)
            {
                _dosenError = pesanUmum;
            }

            if (string.IsNullOrWhiteSpace(_mahasiswaError) && _jumlahMahasiswa == 0)
            {
                _mahasiswaError = pesanUmum;
            }
        }
        finally
        {
            _isLoadingDosen = false;
            _isLoadingMahasiswa = false;
        }
    }

    private async Task MuatDosenAsync()
    {
        _isLoadingDosen = true;
        _dosenError = null;

        try
        {
            await MuatDosenInternalAsync();
        }
        catch (Exception)
        {
            if (string.IsNullOrWhiteSpace(_dosenError))
            {
                _dosenError = "Terjadi kesalahan saat memuat data.";
            }
        }
        finally
        {
            _isLoadingDosen = false;
        }
    }

    private async Task MuatDosenInternalAsync()
    {
        var hasil = await DosenService.GetAllAsync();

        if (hasil.IsSuccess)
        {
            _jumlahDosen = hasil.Data.Count;
        }
        else
        {
            _dosenError = hasil.Error;
        }
    }

    private async Task MuatMahasiswaAsync()
    {
        _isLoadingMahasiswa = true;
        _mahasiswaError = null;

        try
        {
            await MuatMahasiswaInternalAsync();
        }
        catch (Exception)
        {
            if (string.IsNullOrWhiteSpace(_mahasiswaError))
            {
                _mahasiswaError = "Terjadi kesalahan saat memuat data.";
            }
        }
        finally
        {
            _isLoadingMahasiswa = false;
        }
    }

    private async Task MuatMahasiswaInternalAsync()
    {
        var hasil = await MahasiswaService.GetAllAsync();

        if (hasil.IsSuccess)
        {
            _jumlahMahasiswa = hasil.Data.Count;
        }
        else
        {
            _mahasiswaError = hasil.Error;
        }
    }
}
